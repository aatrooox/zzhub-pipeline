{
  "name": "@zzclub/pipeline",
  "version": "0.1.2",
  "type": "module",
  "bin": {
    "zzp": "./dist/cli.js",
    "zzhub-pipeline": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist/cli.js",
    "dist/assets/",
    "dist/node_modules/"
  ],
  "scripts": {
    "dev": "bun run src/cli.ts",
    "build": "bun run scripts/build.ts",
    "build:npm": "bun run scripts/build-npm.ts",
    "build:wechat-preview": "vite build --config vite.wechat-preview.config.ts",
    "prepublishOnly": "bun run scripts/build-npm.ts",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit",
    "release:patch": "changelogen --release --patch --push",
    "release:minor": "changelogen --release --minor --push",
    "release:major": "changelogen --release --major --push"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.5",
    "image-size": "^2.0.2",
    "pngjs": "^7.0.0",
    "zod": "^4.4.2"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^0.1.97",
    "cos-nodejs-sdk-v5": "^2.15.4"
  },
  "devDependencies": {
    "@milkdown/crepe": "^7.18.0",
    "@milkdown/plugin-listener": "^7.18.0",
    "@milkdown/utils": "^7.18.0",
    "@types/bun": "latest",
    "@types/pngjs": "^6.0.5",
    "changelogen": "^0.6.2",
    "typescript": "^5.7.0",
    "vite": "^7.1.10"
  }
}
